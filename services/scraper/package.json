{
  "name": "@cgpu-max/scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "run:once": "tsx src/cli/run-once.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@cgpu-max/types": "workspace:*",
    "@prisma/client": "^5.14.0",
    "axios": "^1.7.2",
    "bullmq": "^5.7.0",
    "cheerio": "^1.0.0-rc.12",
    "ioredis": "^5.4.1",
    "opossum": "^8.1.4",
    "pino": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cgpu-max/config": "workspace:*",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/opossum": "^8.1.8",
    "jest": "^29.7.0",
    "pino-pretty": "^11.0.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
