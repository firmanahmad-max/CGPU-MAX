# Copy to .env.local and fill in. Never commit secrets.

# Database
DATABASE_URL=postgresql://cgpu_user:cgpu_password@localhost:5432/cgpu_max
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
API_URL=http://localhost:3001
NODE_ENV=development
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (Clerk) — get from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/account
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/account

# Stripe — get from https://dashboard.stripe.com
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from Stripe dashboard (Products → Pro plan)
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# App canonical URL — used in Stripe checkout success/cancel URLs
APP_URL=http://localhost:3000

# AI (Phase 5) — get from https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# External data sources (Phase 2)
GEEKBENCH_API_KEY=
TECHPOWERUP_API_KEY=

# Scraper service
SCRAPER_USER_AGENT=CGPU-MAX/0.1 (+https://cgpu-max.app)
SCRAPER_REQUEST_TIMEOUT_MS=15000
SCRAPER_DELAY_MS=1000
SCRAPER_MAX_RETRIES=3
SCRAPER_CRON=0 */6 * * *

# Observability
SENTRY_DSN=
