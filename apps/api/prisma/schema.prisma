// CGPU-MAX initial schema — Phase 1 foundation.
// Expand per modules/{processors,comparisons,bottleneck,pricing,users,subscriptions}.

generator client {
  provider = "prisma-client-js"
  // "native" for local dev; "linux-musl-openssl-3.0.x" for the Alpine container
  // image (node:20-alpine ships openssl 3, not 1.1); "rhel-openssl-3.0.x" for
  // Vercel/AWS Lambda serverless functions.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProcessorType {
  CPU
  GPU
}

enum Manufacturer {
  INTEL
  AMD
  NVIDIA
}

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum AlertDirection {
  BELOW
  ABOVE
}

enum AlertChannel {
  EMAIL
  SMS
  PUSH
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

model Processor {
  id            String        @id @default(uuid()) @db.Uuid
  type          ProcessorType
  manufacturer  Manufacturer
  modelName     String        @map("model_name")
  slug          String        @unique
  codeName      String?       @map("code_name")
  generation    Int?
  releaseDate   DateTime?     @map("release_date") @db.Date
  architecture  String?
  processNm     Int?          @map("process_nm")
  tdpWatts      Int?          @map("tdp_watts")
  msrpUsd       Decimal?      @map("msrp_usd") @db.Decimal(10, 2)

  cpuSpecs    CpuSpecs?
  gpuSpecs    GpuSpecs?
  benchmarks  BenchmarkScore[]
  priceHistory PriceHistory[]
  priceAlerts PriceAlert[]
  comparisonsA SavedComparison[] @relation("ComparisonA")
  comparisonsB SavedComparison[] @relation("ComparisonB")
  bottlenecksCpu SavedBottleneck[] @relation("BottleneckCpu")
  bottlenecksGpu SavedBottleneck[] @relation("BottleneckGpu")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([type, manufacturer])
  @@index([slug])
  @@map("processors")
}

model CpuSpecs {
  processorId         String  @id @map("processor_id") @db.Uuid
  cores               Int
  threads             Int
  baseClockGhz        Decimal @map("base_clock_ghz") @db.Decimal(4, 2)
  boostClockGhz       Decimal? @map("boost_clock_ghz") @db.Decimal(4, 2)
  l3CacheMb           Int?    @map("l3_cache_mb")
  socket              String?
  integratedGraphics  String? @map("integrated_graphics")

  processor Processor @relation(fields: [processorId], references: [id], onDelete: Cascade)

  @@map("cpu_specs")
}

model GpuSpecs {
  processorId           String  @id @map("processor_id") @db.Uuid
  shaderUnits           Int     @map("shader_units")
  vramGb                Int     @map("vram_gb")
  vramType              String? @map("vram_type")
  memoryBusBits         Int?    @map("memory_bus_bits")
  memoryBandwidthGbps   Decimal? @map("memory_bandwidth_gbps") @db.Decimal(8, 2)
  baseClockMhz          Int     @map("base_clock_mhz")
  boostClockMhz         Int?    @map("boost_clock_mhz")
  rayTracingCores       Int?    @map("ray_tracing_cores")
  tensorCores           Int?    @map("tensor_cores")

  processor Processor @relation(fields: [processorId], references: [id], onDelete: Cascade)

  @@map("gpu_specs")
}

model BenchmarkScore {
  id            String   @id @default(uuid()) @db.Uuid
  processorId   String   @map("processor_id") @db.Uuid
  benchmarkType String   @map("benchmark_type")
  score         Decimal  @db.Decimal(12, 2)
  source        String
  recordedAt    DateTime @map("recorded_at")

  processor Processor @relation(fields: [processorId], references: [id], onDelete: Cascade)

  @@index([processorId, benchmarkType])
  @@map("benchmarks")
}

model PriceHistory {
  id          String   @id @default(uuid()) @db.Uuid
  processorId String   @map("processor_id") @db.Uuid
  retailer    String
  priceUsd    Decimal  @map("price_usd") @db.Decimal(10, 2)
  inStock     Boolean  @default(true) @map("in_stock")
  recordedAt  DateTime @map("recorded_at")

  processor Processor @relation(fields: [processorId], references: [id], onDelete: Cascade)

  @@index([processorId, recordedAt(sort: Desc)])
  @@map("price_history")
}

model User {
  id           String           @id @default(uuid()) @db.Uuid
  email        String           @unique
  displayName  String?          @map("display_name")
  tier         SubscriptionTier @default(FREE)
  role         UserRole         @default(USER)
  clerkUserId  String?          @unique @map("clerk_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  savedComparisons SavedComparison[]
  savedBottlenecks SavedBottleneck[]
  savedBuilds      SavedBuild[]
  subscriptions    Subscription[]
  usageCounters    UsageCounter[]
  apiKeys          ApiKey[]
  priceAlerts      PriceAlert[]
  orgMemberships   OrganizationMember[]
  stripeCustomerId String?  @unique @map("stripe_customer_id")

  @@index([email])
  @@map("users")
}

model Subscription {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @map("user_id") @db.Uuid
  tier                SubscriptionTier
  status              SubscriptionStatus
  interval            BillingInterval
  stripeSubscriptionId String             @unique @map("stripe_subscription_id")
  stripePriceId       String              @map("stripe_price_id")
  currentPeriodStart  DateTime            @map("current_period_start")
  currentPeriodEnd    DateTime            @map("current_period_end")
  cancelAtPeriodEnd   Boolean             @default(false) @map("cancel_at_period_end")
  canceledAt          DateTime?           @map("canceled_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}

// Per-(user, feature, period) counter used to enforce tier limits.
// `period` is a string like "2026-06" so counters auto-rotate monthly.
model UsageCounter {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  feature   String
  period    String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature, period])
  @@map("usage_counters")
}

// AI Build Advisor output — persisted recommendation (Pro feature).
model SavedBuild {
  id            String   @id @default(uuid()) @db.Uuid
  shareSlug     String   @unique @map("share_slug")
  ownerId       String   @map("owner_id") @db.Uuid
  budgetUsd     Int      @map("budget_usd")
  purpose       String
  resolution    String
  payload       Json     // Full structured recommendation from Claude.
  modelUsed     String   @map("model_used")
  createdAt     DateTime @default(now()) @map("created_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([shareSlug])
  @@map("saved_builds")
}

// Price-drop alert (Pro feature). Evaluated by the scraper after each ingestion
// run; `triggeredAt` is set when the latest price crosses the target.
model PriceAlert {
  id             String         @id @default(uuid()) @db.Uuid
  ownerId        String         @map("owner_id") @db.Uuid
  processorId    String         @map("processor_id") @db.Uuid
  targetPriceUsd Decimal        @map("target_price_usd") @db.Decimal(10, 2)
  direction      AlertDirection @default(BELOW)
  channel        AlertChannel   @default(EMAIL)
  active         Boolean        @default(true)
  triggeredAt    DateTime?      @map("triggered_at")
  triggeredPriceUsd Decimal?    @map("triggered_price_usd") @db.Decimal(10, 2)
  lastCheckedAt  DateTime?      @map("last_checked_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  processor Processor @relation(fields: [processorId], references: [id], onDelete: Cascade)

  @@index([ownerId, active])
  @@index([processorId, active])
  @@map("price_alerts")
}

// White-label tenant. Branding fields drive the themed frontend; `customDomain`
// (unique) lets a white-label deployment resolve its theme by hostname.
model Organization {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  slug              String   @unique
  customDomain      String?  @unique @map("custom_domain")
  brandName         String?  @map("brand_name")
  logoUrl           String?  @map("logo_url")
  primaryColorHex   String?  @map("primary_color_hex")
  secondaryColorHex String?  @map("secondary_color_hex")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  members OrganizationMember[]

  @@index([slug])
  @@index([customDomain])
  @@map("organizations")
}

model OrganizationMember {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      OrgRole  @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("organization_members")
}

// Enterprise REST API credential. We store only the SHA-256 hash of the key;
// the plaintext is shown to the user exactly once at creation. `keyPrefix` is a
// short non-secret fragment for identifying the key in the UI.
model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  name        String
  keyPrefix   String    @map("key_prefix")
  hashedKey   String    @unique @map("hashed_key")
  scopes      String[]  @default(["read"])
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([hashedKey])
  @@map("api_keys")
}

// Append-only ledger of Stripe webhook events for idempotency + audit.
model StripeWebhookEvent {
  id         String   @id // Stripe event id (evt_...)
  type       String
  receivedAt DateTime @default(now()) @map("received_at")
  payload    Json

  @@index([type])
  @@map("stripe_webhook_events")
}

// Persisted comparison results. Shareable via `shareSlug` (public URL).
// Free tier retention: 7 days; Pro: 1 year — enforced by retention job, not schema.
model SavedComparison {
  id          String   @id @default(uuid()) @db.Uuid
  shareSlug   String   @unique @map("share_slug")
  aId         String   @map("a_id") @db.Uuid
  bId         String   @map("b_id") @db.Uuid
  ownerId     String?  @map("owner_id") @db.Uuid
  payload     Json     // Snapshot of full comparison result for cache-friendly retrieval.
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")

  a     Processor @relation("ComparisonA", fields: [aId], references: [id], onDelete: Cascade)
  b     Processor @relation("ComparisonB", fields: [bId], references: [id], onDelete: Cascade)
  owner User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([shareSlug])
  @@map("saved_comparisons")
}

model SavedBottleneck {
  id          String   @id @default(uuid()) @db.Uuid
  shareSlug   String   @unique @map("share_slug")
  cpuId       String   @map("cpu_id") @db.Uuid
  gpuId       String   @map("gpu_id") @db.Uuid
  ownerId     String?  @map("owner_id") @db.Uuid
  payload     Json
  algorithmVersion String @map("algorithm_version")
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")

  cpu   Processor @relation("BottleneckCpu", fields: [cpuId], references: [id], onDelete: Cascade)
  gpu   Processor @relation("BottleneckGpu", fields: [gpuId], references: [id], onDelete: Cascade)
  owner User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([shareSlug])
  @@map("saved_bottlenecks")
}
