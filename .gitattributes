# Normalize line endings: store LF in the repo, check out native on each OS.
# Keeps diffs clean across Windows/Linux/macOS contributors and CI.
* text=auto eol=lf

# Shell scripts must stay LF even on Windows checkouts.
*.sh text eol=lf

# Binary assets — never normalize or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.xlsx binary
*.woff binary
*.woff2 binary
*.ttf binary
